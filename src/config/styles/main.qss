/* Global default widget styles — component-specific styles in separate .qss files */

QFrame#bottom_widget, QFrame#settings_widget {
    background-color: %frame_bg_color%;
    border-radius: %custom_border_radius%;
}
QWidget {
    font-family: "%font_family_main%", sans-serif;
    outline: none;
    font-size: %font_size_main%pt;
    color: %main_text_color%;
    background-color: transparent;
}
QDialog, QMessageBox {
    font-family: "%font_family_main%", sans-serif;
    font-size: %font_size_small%pt;
    color: %main_text_color%;
    background-color: %frame_bg_color%;
    border: 3px solid %border_color%;
    border-radius: %custom_border_radius%;
}
QDialog > QLabel, QMessageBox > QLabel {
    background: transparent;
    font-size: %font_size_small%pt;
}
QDialog QPushButton, QMessageBox QPushButton {
    font-size: %font_size_small%pt;
}
QPushButton {
    background-color: %button_color%;
    border: 2px solid %border_color%;
    color: %main_text_color%;
    padding: 6px 16px;
    min-height: 30px;
    border-radius: %button_border_radius%;
}
QPushButton:hover {
    background-color: %button_hover_color%;
}
QPushButton:disabled, QComboBox:disabled {
    background-color: #333333;
    color: #888888;
    border: 2px solid #555555;
}
QPushButton#addLocalizationButton {
    min-width: 33px;
    min-height: 33px;
    padding: 2px;
    border-radius: %add_localization_button_radius%;
}
QComboBox {
    background-color: %button_color%;
    color: %main_text_color%;
    border: 2px solid %border_color%;
    padding: 5px 10px;
    min-height: 30px;
    border-radius: %field_border_radius%;
}
QComboBox::drop-down {
    subcontrol-origin: border;
    subcontrol-position: center right;
    background: transparent;
    border: none;
    width: 30px;
    margin-right: 4px;
}
QComboBox::down-arrow {
    image: url(%arrow_down_path%);
    width: 16px;
    height: 10px;
}
QComboBox QAbstractItemView {
    background-color: %button_color%;
    border: 2px solid %border_color%;
    color: %main_text_color%;
    selection-background-color: %button_hover_color%;
    border-radius: %custom_border_radius%;
}
QLineEdit {
    background-color: %frame_bg_color%;
    color: %main_text_color%;
    border: 2px solid %border_color%;
    padding: 5px 10px;
    qproperty-alignment: 'AlignCenter';
    border-radius: %field_border_radius%;
}
QListWidget {
    background-color: %frame_bg_color%;
    color: %main_text_color%;
    border: 2px solid %border_color%;
    border-radius: %custom_border_radius%;
}
QListWidget::item {
    color: %main_text_color%;
}
QListWidget::item:selected {
    background-color: %button_hover_color%;
}
QSpinBox {
    background-color: %frame_bg_color%;
    color: %main_text_color%;
    border: 2px solid %border_color%;
    padding: 5px 10px;
    qproperty-alignment: 'AlignCenter';
    border-radius: %field_border_radius%;
}
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    background: transparent;
    border: none;
    border-left: none;
    width: 24px;
    margin-right: 2px;
}
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    background: transparent;
    border: none;
    border-left: none;
    width: 24px;
    margin-right: 2px;
}
QSpinBox::up-arrow {
    image: url(%arrow_up_path%);
    width: 12px;
    height: 8px;
}
QSpinBox::down-arrow {
    image: url(%arrow_down_path%);
    width: 12px;
    height: 8px;
}
QTextEdit, QTextBrowser {
    background-color: %frame_bg_color%;
    color: %main_text_color%;
    border: 2px solid %border_color%;
    min-height: 100px;
    border-radius: %editor_border_radius%;
}
QTabBar::tab {
    background-color: %button_color%;
    color: %main_text_color%;
    border: 2px solid %border_color%;
    padding: 4px 12px;
    min-height: 23px;
    border-radius: %tab_border_radius%;
    margin-right: 4px;
}
QTabBar::tab:selected, QTabBar::tab:hover {
    background-color: %button_hover_color%;
}
QTabBar::tab:disabled {
    background-color: #333333;
    color: #888888;
    border: 2px solid #555555;
}
QTabWidget::pane {
    background: transparent;
    border: 0px;
}
QCheckBox:disabled {
    color: #888888;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    background-color: %button_color%;
    border: 2px solid %border_color%;
    border-radius: %checkbox_indicator_radius%;
}
QCheckBox::indicator:checked {
    background-color: %checkbox_checked_color%;
}
QCheckBox::indicator:disabled {
    background-color: #333333;
    border: 2px solid #555555;
}
QPushButton:checked {
    background-color: %button_hover_color%;
    border: 2px solid %main_text_color%;
}
